Select
  # this is general syntax         (SELECT COLUMN1, COLUMN2, ... FROM TABLE_1 ;)          EX: SELECT Title, Director, Writer FROM FilmLocations;
  # to get all Columns use "*"     (SELECT * FROM TABLE_1 ;)                              EX: SELECT * FROM FilmLocations;
  # Where clause                   (SELECT <COLUMNS> FROM TABLE_1 WHERE <predicate> ;)    EX: SELECT Title, ReleaseYear, Locations FROM FilmLocations WHERE ReleaseYear>=2001;   
  # Count                          (SELECT COUNT(*) FROM Column1;)                        EX: SELECT COUNT(*) FROM FilmLocations;
  # DISTINCT                       (SELECT DISTINCT Title FROM Column2;)                  EX: SELECT DISTINCT Title FROM FilmLocations;
  # LIMIT                          (SELECT * FROM TABLE1 LIMIT 25;)                       EX: SELECT * FROM FilmLocations LIMIT 25;
  # lIMIT - NOT FROM THE TOP       (SELECT * FROM FilmLocations LIMIT 15 OFFSET 10;)      EX: SELECT * FROM FilmLocations LIMIT 15 OFFSET 10;
